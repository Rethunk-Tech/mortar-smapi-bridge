<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.*" />
    <!-- The mod references SMAPI and Harmony without copying them; tests that construct FrameProfiler load SMAPI types. -->
    <Reference Include="StardewModdingAPI" HintPath="../../lib/StardewModdingAPI.dll" />
    <Reference Include="0Harmony" HintPath="../../lib/0Harmony.dll" />
    <ProjectReference Include="../../src/MortarSmapiBridge/MortarSmapiBridge.csproj" />
  </ItemGroup>
</Project>
